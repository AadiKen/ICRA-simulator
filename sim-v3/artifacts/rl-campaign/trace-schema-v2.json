{
  "schema_version": "trace-schema-v2",
  "source_of_truth": "validation/rl-campaign/ports/trace-schema-v2.ts",
  "supersedes": "trace-schema-v1",
  "version_note": "The 2026-09-02 Surveyor reauthorization appends normalized time remaining as observation field 16. Fields 1-15 are unchanged and retain their prior order. All trace-schema-v1 conformance evidence is invalid for this contract revision.",
  "task_contract": {
    "task_id": "common-waypoint-transit-v1",
    "content_sha256": "63eb33ad66078e1f28b20504d4187c9d0efd42538dd018f592a307f0f98b55a2"
  },
  "timing": {
    "physics_timestep_s": 0.05,
    "control_interval_s": 0.1,
    "sample_interval_s": 0.05,
    "episode_length_steps": 2400
  },
  "coordinate_convention": {
    "world": "local NED",
    "state": ["N_m", "E_m", "yaw_rad", "u_mps", "v_mps", "r_rad_s"],
    "yaw": "clockwise from north",
    "body_velocity": "surge/sway in the vessel body frame",
    "gazebo_enu_mapping": {
      "position": "N=enu.y; E=enu.x; D=-enu.z",
      "yaw": "yaw_ned=pi/2-yaw_enu",
      "yaw_rate": "r_ned=-r_enu",
      "body_velocity": "Convert ENU world velocity to N/E first, then use nedWorldToBody2D(N_dot,E_dot,yaw_ned)."
    }
  },
  "reset": {
    "required": ["seed", "initial_state", "route_ned_m", "disturbance"],
    "initial_state": ["N_m", "E_m", "yaw_rad", "u_mps", "v_mps", "r_rad_s"],
    "disturbance": ["wind_speed_m_s", "wind_direction_deg", "current_speed_m_s", "current_direction_deg"]
  },
  "action_trace": {
    "fields": ["step", "time_s", "command"],
    "command": ["effector_0", "effector_1", "steer_0", "steer_1"],
    "range": [-1, 1],
    "unused_fields_must_be_zero": ["steer_0", "steer_1"]
  },
  "sample": {
    "fields": ["step", "time_s", "state", "observation", "applied_action"],
    "state": ["N_m", "E_m", "yaw_rad", "u_mps", "v_mps", "r_rad_s"],
    "observation_encoding": "float64-vector",
    "observation": ["imu.linear_accel_x", "imu.linear_accel_y", "imu.linear_accel_z", "imu.angular_rate_x", "imu.angular_rate_y", "imu.angular_rate_z", "gps.relative_goal_north_m", "gps.relative_goal_east_m", "gps.ground_speed_north_m_s", "gps.ground_speed_east_m_s", "gps.fix_valid", "previous_action.effector_0", "previous_action.effector_1", "previous_action.steer_0", "previous_action.steer_1", "normalized_time_remaining"],
    "normalized_time_remaining": "Remaining episode physics steps divided by 2400; 1.0 at reset and 0.0 at the 120 s limit.",
    "applied_action": ["effector_0", "effector_1", "steer_0", "steer_1"],
    "applied_action_rule": "actual normalized actuator command after simulator-native lag/transport handling; never a derived body wrench"
  },
  "trace": {
    "required": ["schema_version", "simulator", "reset", "action_trace", "samples"],
    "simulator_values": ["Gazebo Harmonic", "VRX"]
  }
}
